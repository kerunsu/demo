# 使用方式：复制本文件为 backend/.env 并重启 backend。
# 仅修改 .env.example 不会生效；运行时读取的是 backend/.env。

# 语音与模型提供方配置
# 可选值: rule | openai
AI_CHAT_PROVIDER=rule
# Enable the ASD conversation agent from ExpertAnnotator_ASD-main:
# AI_CHAT_PROVIDER=asd
# ASD_AGENT_ENV_FILE=E:\demo_project\ExpertAnnotator_ASD-main\asd_llm_agent\.env
# ASD_LLM_API_KEY=your_llm_api_key
# ASD_LLM_BASE_URL=https://api.deepseek.com
# ASD_LLM_MODEL=deepseek-chat

# 可选值: none | openai
AI_TTS_PROVIDER=none

# OpenAI 配置（当 provider=openai 时必填）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
# 报告 V2 叙事 LLM（独立于语音对话 AI_CHAT_PROVIDER）
# 可选值: rule | mock | openai | deepseek
REPORT_NARRATIVE_PROVIDER=mock
OPENAI_REPORT_MODEL=gpt-4o-mini

# DeepSeek 报告叙事（REPORT_NARRATIVE_PROVIDER=deepseek 时填写）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_REPORT_MODEL=deepseek-chat
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# 语音对话黑盒（可选，默认 rule 走内置规则回复）
# rule | partner
VOICE_DIALOG_PROVIDER=rule
# VOICE_PARTNER_BASE_URL=http://127.0.0.1:9876
# VOICE_PARTNER_API_KEY=dev-partner-key
# VOICE_PARTNER_TIMEOUT_MS=30000
# VOICE_PARTNER_FALLBACK=none

# Development local voice main flow.
# Start tools/voice-service/voice_service.py with:
# VOICE_SERVICE_STT_PROVIDER=local-vosk
# VOICE_SERVICE_TTS_PROVIDER=local-piper
VOICE_STT_PROVIDER=local
# Enable ExpertAnnotator_ASD-main FunASR STT:
# VOICE_SERVICE_STT_PROVIDER=local-funasr
# VOICE_SERVICE_PYTHON=E:\demo_project\ExpertAnnotator_ASD-main\asd_llm_agent\.venv\Scripts\python.exe
VOICE_TTS_PROVIDER=local
VOICE_PYTHON_SERVICE_URL=http://127.0.0.1:8765
ATTENTION_PROVIDER=local

# Development persistence. Raw audio, video, and frames are not saved by default.
DEMO_STORAGE_PROVIDER=sqlite
DEMO_SQLITE_DB_PATH=.runtime/demo.sqlite3

# Raw media persistence (disabled by default). Enable only with consent, retention, and deletion drills.
RAW_MEDIA_PERSISTENCE=disabled
RAW_MEDIA_ROOT=.runtime/media
RAW_MEDIA_RETENTION_DAYS=7
RAW_MEDIA_REQUIRE_CONSENT=true
RAW_MEDIA_ENCRYPTION=optional
