# 复制为 .env 后按需修改；.env 已被忽略，禁止提交密钥。
# 详见 docs/ENVIRONMENT.md。

# Flask：正式部署必须替换。
SECRET_KEY=change-me-in-production

# 可选：数据库与分析器。
# EIART_DATABASE_PATH=database/app.db
# USE_REAL_ANALYZERS=true

# 浏览器采集与写盘参数。
# VIDEO_FPS=30
# VIDEO_WIDTH=640
# VIDEO_HEIGHT=480
# AUDIO_SAMPLE_RATE=16000
# AUDIO_CHANNELS=1
# BROWSER_JPEG_QUALITY=50
# MEDIA_UPLOAD_SHARED_KEY=

# 分析开关。
# POSE_ESTIMATION_ENABLED=true
# FACE_ANALYSIS_ENABLED=true
# AUDIO_ANALYSIS_ENABLED=true

# 儿童对话与浏览器语音。
DIALOGUE_ENABLED=true
DIALOGUE_TTS_MODE=browser
DIALOGUE_WAKE_WORD_ENABLED=false
# BROWSER_SPEECH_RATE=0.88
AI_CHAT_PROVIDER=asd
# 只引用本机密钥文件，不要提交该文件。
ASD_AGENT_ENV_FILE=../ExpertAnnotator_ASD-main/asd_llm_agent/.env

# 可选本地语音诊断服务；儿童端生产采集仍固定为 browser。
VOICE_PYTHON_SERVICE_URL=http://127.0.0.1:8765
# START_VOICE_SERVICE=false

# 日志。
# LOG_LEVEL=INFO

# 局域网 HTTPS（摄像头/麦克风安全上下文）。
# ENABLE_HTTPS=true
# SSL_CERTFILE=.runtime/certs/cert.pem
# SSL_KEYFILE=.runtime/certs/key.pem
# VITE_BACKEND_URL=https://127.0.0.1:8080

# Demo 固定边界：不要添加 CHILD_MEDIA_MODE=agent、ROBOT_CONTROL_MODE、
# Robot Runtime、DollSer、机械动作或完整版表情配置；代码会拒绝启用。
