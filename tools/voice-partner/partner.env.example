# Copy to partner.env and adjust. Loaded by reference_server.py (optional).

# Listen (reference server only)
PARTNER_HOST=127.0.0.1
PARTNER_PORT=9876

# Auth: must match backend VOICE_PARTNER_API_KEY when set
PARTNER_API_KEY=dev-partner-key

# Which page context fields to use (we always send text + screenshot)
CONTEXT_INPUT_MODE=both
# text | image | both

# Partner-internal STT strategy (independent from our browser STT)
STT_MODE=audio
# audio | text_only_fallback | none

# Optional external LLM/TTS HTTP endpoints (reference server ignores if unset)
LLM_HTTP_URL=
TTS_HTTP_URL=
