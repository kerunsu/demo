# 分析器配置文件示例
# 复制此文件为 config/analyzers.yaml 并根据需要修改

# 全局配置
global:
  # 全局模式: 'mock' 或 'real'（仓库默认 real；无模型时用 USE_REAL_ANALYZERS=false）
  # 环境变量 USE_REAL_ANALYZERS=true/false 可以覆盖此设置
  mode: real
  
  # 是否启用采样控制
  enable_sampling: true
  
  # 是否启用性能指标收集
  enable_metrics: false

# 分析器配置
analyzers:
  # 姿态分析器
  pose:
    mode: null  # null 表示继承 global.mode
    enabled: true
    sample_rate: 1.0  # 1.0 = 每帧分析，0.5 = 每2帧分析1次
    
    # Real 模式参数
    model_path: models/pose_landmarker_lite.task
    min_detection_confidence: 0.5
    num_poses: 1
  
  # 表情分析器
  face:
    mode: null
    enabled: true
    sample_rate: 1.0
    
    # Real 模式参数（待实现）
    model_path: models/face_model.onnx
    confidence_threshold: 0.6
  
  # 注意力分析器
  attention:
    mode: null
    enabled: true
    window_size: 10.0  # 滑动窗口大小（秒）
    
    # Real 模式参数 (MediaPipe Face Mesh)
    pose_threshold: 20.0  # 头部偏转阈值（度）
    min_detection_confidence: 0.5
    min_tracking_confidence: 0.5
  
  # 本地语音识别分析器（生产儿童端使用浏览器 SpeechRecognition，默认关闭）
  speech:
    mode: null
    enabled: false
    sample_rate: 1.0
    
    # Real 模式参数 (FunASR Paraformer)
    model_name: paraformer-zh  # FunASR 模型名称
    device: cuda               # 推理设备: cuda 或 cpu
    sample_rate_audio: 16000   # 音频采样率
    accumulation_duration: 2.0 # 连续识别窗口（秒）
    rms_threshold: 0.006       # 整段最低 RMS，过滤近静音
    frame_rms_threshold: 0.014 # 20ms 有声帧最低 RMS
    peak_threshold: 0.02       # 有声帧最低峰值
    min_voiced_ratio: 0.12     # 窗口内至少约 240ms 有效语音
    max_input_gain: 3.0        # ASR 输入最大增益，禁止微声放大到满幅

# 比对器配置
matchers:
  # 姿态比对器
  pose:
    mode: null
    enabled: true
    threshold: 0.50  # 动作关节加权匹配阈值（0-1），与当前部署默认一致
    min_keypoint_visibility: 0.35
    action_sigma: 0.55
    allow_mirror: true  # 左右镜像动作也可判为正确
    stable_frames: 4
    stable_hold_seconds: 0.6  # 连续保持，防止路过姿态误触发
    max_frame_gap_seconds: 0.55
  
  # 语音比对器
  speech:
    mode: null
    enabled: false
    threshold: 60.0  # 及格分数线 (0-100)

# 性能优化配置
performance:
  # 最大并发分析数
  max_concurrent_analyzers: 4
  
  # 分析超时时间（秒）
  analysis_timeout: 5.0
  
  # 队列大小
  queue_size: 100

# 日志配置
logging:
  # 日志级别: DEBUG, INFO, WARNING, ERROR
  level: INFO
  
  # 是否记录性能指标
  log_metrics: true

