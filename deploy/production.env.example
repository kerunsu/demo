# M7-A production backend environment template.
# Copy outside Git-tracked paths before use. Do not commit real secrets.

NODE_ENV=production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3001
PUBLIC_BACKEND_ORIGIN=http://SERVER_LAN_IP:3001
CORS_ORIGIN=http://ROBOT_LAN_IP:5173

# Default safe providers for local field rehearsal.
AI_CHAT_PROVIDER=rule
AI_TTS_PROVIDER=none
VOICE_DIALOG_PROVIDER=rule
# VOICE_PARTNER_BASE_URL=http://PARTNER_LAN_IP:9876
# VOICE_PARTNER_API_KEY=SET_IN_SECURE_HOST_ENV_ONLY
# VOICE_PARTNER_FALLBACK=none
VOICE_STT_PROVIDER=mock
VOICE_TTS_PROVIDER=mock
VOICE_PYTHON_SERVICE_URL=http://127.0.0.1:8765
ATTENTION_PROVIDER=mock
DEMO_STORAGE_PROVIDER=sqlite
DEMO_SQLITE_DB_PATH=.runtime/demo.sqlite3

# For approved local real-provider rehearsal only:
# VOICE_STT_PROVIDER=local
# VOICE_TTS_PROVIDER=local
# ATTENTION_PROVIDER=local
# Voice Service process env:
# VOICE_SERVICE_STT_PROVIDER=local-vosk
# VOICE_SERVICE_TTS_PROVIDER=local-piper
# VOICE_SERVICE_VOSK_MODEL=.runtime/models/vosk/vosk-model-small-cn-0.22
# VOICE_SERVICE_PIPER_MODEL=.runtime/models/piper/zh_CN-huayan-medium.onnx
# VOICE_SERVICE_PIPER_CONFIG=.runtime/models/piper/zh_CN-huayan-medium.onnx.json

# Optional cloud providers remain disabled until explicit safety review.
OPENAI_API_KEY=SET_IN_SECURE_HOST_ENV_ONLY
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Operations paths.
DEMO_LOG_DIR=.runtime/logs
DEMO_BACKUP_DIR=.runtime/backups
DEMO_RETENTION_DAYS=30
